# Used by docker-compose.yml. The site address comes from TUBEHAUS_SITE in .env
# (a domain gets HTTPS automatically; ":8080" serves plain HTTP on a LAN).
#
# TubeHaus has no accounts of its own. For a simple password, set in .env:
#   TUBEHAUS_AUTH=basic
#   TUBEHAUS_USER=me
#   TUBEHAUS_PASSWORD_HASH=<from: docker compose run --rm caddy caddy hash-password>  (write every $ as $$)
# or put Authelia / Authentik / a passkey gate in front with forward_auth instead.

(auth-none) {
}

(auth-basic) {
	basic_auth {
		{$TUBEHAUS_USER} {$TUBEHAUS_PASSWORD_HASH}
	}
}

{$TUBEHAUS_SITE} {
	encode zstd gzip
	import auth-{$TUBEHAUS_AUTH:none}

	# privacy and hardening: no referrer to other sites, no FLoC/Topics, no MIME sniffing,
	# no framing by other sites, and keep search engines out of a private instance
	header {
		Referrer-Policy same-origin
		X-Content-Type-Options nosniff
		X-Frame-Options SAMEORIGIN
		Permissions-Policy "interest-cohort=(), browsing-topics=()"
		-Server
	}
	handle /robots.txt {
		respond <<TXT
			User-agent: *
			Disallow: /
			TXT 200
	}

	handle /y/* {
		root * /srv/web
		header Cache-Control "no-cache"
		file_server
	}

	@page {
		method GET HEAD
		path / /watch /results /shorts /shorts/* /channel/* /c/* /user/* /@* /playlist /feed/* /settings /hashtag/*
		header Accept *text/html*
		not path /feed/channel/* /feed/playlist/* /feed/private* /feed/webhook/*
		not query classic=*
	}
	handle @page {
		root * /srv/web
		header Cache-Control "no-cache"
		rewrite * /index.html
		file_server
	}

	handle /api/p/* {
		reverse_proxy tubehaus:3010 {
			flush_interval -1
		}
	}
	handle /api/v1/videos/* {
		reverse_proxy tubehaus:3010
	}
	@dl {
		path /latest_version /companion/latest_version
		query title=*
	}
	handle @dl {
		reverse_proxy tubehaus:3010 {
			flush_interval -1
		}
	}
	handle /companion/* {
		reverse_proxy companion:8282 {
			flush_interval -1
		}
	}
	handle {
		reverse_proxy invidious:3000
	}
}
