# Used by docker-compose.yml. The site address comes from TUBEHAUS_SITE in .env
# (a domain gets HTTPS automatically; ":8080", the default, serves plain HTTP on a LAN).
# The tubehaus-web image has this file and the web app built in; TUBEHAUS_SERVER points it at the
# TubeHaus server container when it is not called tubehaus.
#
# Without a login everyone who opens the address shares one library. In .env:
#   TUBEHAUS_AUTH=basic       one shared password:
#     TUBEHAUS_USER=me
#     TUBEHAUS_PASSWORD_HASH=<from: docker compose run --rm caddy caddy hash-password>  (write every $ as $)
#   TUBEHAUS_AUTH=accounts    everyone signs up with a name and password and gets a library of their own
#     (TUBEHAUS_MAX_ACCOUNTS=4 closes sign-ups once the household has its accounts)
# or put Authelia / Authentik / a passkey gate in front with forward_auth instead.

(auth-none) {
}

(auth-basic) {
	basic_auth {
		{$TUBEHAUS_USER} {$TUBEHAUS_PASSWORD_HASH}
	}
}

(auth-accounts) {
	# the sign-up / sign-in pages and their API stay open; everything else needs an account
	@member not path /signup /login /y/* /api/p/auth/* /api/p/health /robots.txt
	forward_auth @member {$TUBEHAUS_SERVER:tubehaus:3010} {
		uri /api/p/auth/check
		@unauth status 401
		handle_response @unauth {
			@htmlreq header Accept *text/html*
			redir @htmlreq /login?r={uri} 302
			respond 401
		}
	}
	handle /signup {
		root * /srv/web
		header Cache-Control "no-cache"
		rewrite * /y/auth.html
		file_server
	}
	handle /login {
		root * /srv/web
		header Cache-Control "no-cache"
		rewrite * /y/auth.html
		file_server
	}
}

{$TUBEHAUS_SITE::8080} {
	encode zstd gzip
	import auth-{$TUBEHAUS_AUTH:none}

	# privacy and hardening: no referrer to other sites, no FLoC/Topics, no MIME sniffing,
	# no framing by other sites, and keep search engines out of a private instance
	header {
		Referrer-Policy same-origin
		X-Content-Type-Options nosniff
		X-Frame-Options SAMEORIGIN
		Permissions-Policy "interest-cohort=(), browsing-topics=()"
		-Server
	}
	handle /robots.txt {
		respond <<TXT
			User-agent: *
			Disallow: /
			TXT 200
	}

	handle /y/* {
		root * /srv/web
		header Cache-Control "no-cache"
		file_server
	}

	@page {
		method GET HEAD
		path / /watch /results /shorts /shorts/* /channel/* /c/* /user/* /@* /playlist /feed/* /settings /hashtag/*
		header Accept *text/html*
		not path /feed/channel/* /feed/playlist/* /feed/private* /feed/webhook/*
		not query classic=*
	}
	handle @page {
		root * /srv/web
		header Cache-Control "no-cache"
		rewrite * /index.html
		file_server
	}

	# everything else: the TubeHaus server (its API, YouTube's answers, the video streams, captions and pictures)
	handle {
		reverse_proxy {$TUBEHAUS_SERVER:tubehaus:3010} {
			flush_interval -1
		}
	}
}
