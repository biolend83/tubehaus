# ============ docker compose (docker-compose.yml) ============
# copy to .env and fill these in

# Three setups (README, "Quick start"):
#   your domain, Caddy gets the certificate:  TUBEHAUS_SITE=tube.example.com (the defaults below)
#   plain HTTP on a LAN:                      TUBEHAUS_SITE=:80  TUBEHAUS_HTTP_BIND=8080
#                                             TUBEHAUS_URL=http://192.168.1.10:8080  TUBEHAUS_HTTPS=false  TUBEHAUS_EXTERNAL_PORT=8080
#   behind your own nginx/Traefik:            TUBEHAUS_SITE=:80  TUBEHAUS_HTTP_BIND=127.0.0.1:8080  TUBEHAUS_HTTPS_BIND=127.0.0.1:8443
#                                             (URL, DOMAIN, HTTPS, EXTERNAL_PORT = what your proxy serves)

# what Caddy answers inside the container: a domain for automatic HTTPS, or ":80" for plain HTTP
TUBEHAUS_SITE=tube.example.com
# where browsers open TubeHaus
TUBEHAUS_URL=https://tube.example.com
TUBEHAUS_DOMAIN=tube.example.com
TUBEHAUS_HTTPS=true
TUBEHAUS_EXTERNAL_PORT=443
# the host ports Caddy is published on: a port ("8080") or an address and port ("127.0.0.1:8080")
TUBEHAUS_HTTP_BIND=80
TUBEHAUS_HTTPS_BIND=443

# secrets - make up your own:  openssl rand -hex 8  (COMPANION_KEY must be exactly 16 characters)
COMPANION_KEY=change-me-16char
INVIDIOUS_HMAC_KEY=change-me-to-something-long
POSTGRES_PASSWORD=change-me

# optional built-in login (recommended before exposing TubeHaus to the internet)
#   TUBEHAUS_AUTH=basic, then a user name and a bcrypt hash from:
#   docker compose run --rm caddy caddy hash-password
#   (in this file every $ in the hash must be written as $$)
TUBEHAUS_AUTH=none
TUBEHAUS_USER=
TUBEHAUS_PASSWORD_HASH=

# running a public instance for strangers? set this to 1: every visitor keeps their own
# library in their browser, the server stores none, and send-to-TV / server downloads are off.
# Read "Running a public instance" in the README first.
TUBEHAUS_PUBLIC=0
# deploy/docker-compose.public.yml only: key for the Anubis bot check (openssl rand -hex 32)
ANUBIS_KEY=
# load limits (0 = no limit). For a public instance something like 50 viewers and 1080p is sensible.
# people watching at once; newcomers beyond it get "busy, try again in a few minutes"
TUBEHAUS_MAX_VIEWERS=0
# highest quality offered, e.g. 1080 (bandwidth)
TUBEHAUS_MAX_HEIGHT=0
# API requests per visitor per minute (empty: 120 on public instances, off otherwise)
TUBEHAUS_RATE_PER_MIN=

# translated subtitles target / live caption language
TUBEHAUS_SUB_LANG=en
TUBEHAUS_CAPTION_LANG=auto


# ============ running the server without docker (deploy/tubehaus.service) ============
# HT_BIND=127.0.0.1
# HT_PORT=3010
# HT_STATE=./state                          # library and subtitle cache
# HT_INVIDIOUS=http://127.0.0.1:3000
# HT_COMPANION=http://127.0.0.1:8282
# HT_PUBLIC_URL=https://tube.example.com    # where browsers open TubeHaus
# HT_YT_PROXY=127.0.0.1:40000               # Cloudflare WARP in proxy mode ("" = direct)
# HT_WARP_ROTATE=1                          # reconnect WARP when YouTube blocks the address
# HT_YTDLP=yt-dlp                           # + bgutil-ytdlp-pot-provider, for live streams
# HT_WHISPER_BIN=/opt/whisper/build/bin/whisper-cli
# HT_WHISPER_MODEL=/opt/whisper/models/ggml-base-q5_1.bin
# HT_WHISPER_LANG=auto
# HT_SUB_LANG=en
# HT_LIBRETRANSLATE=                        # optional translation fallback
# HT_DOWNLOAD_DIR=/var/tmp/tubehaus-dl      # offline save (needs ffmpeg, ~10 GB free)
