# ============ docker compose (docker-compose.yml) ============
# copy to .env, put your address in, then: docker compose up -d
# Open TubeHaus in a browser: a new server asks how it'll be used (alone, a family, anyone, no sign-in),
# with the setup code from: docker compose logs tubehaus
# Everything else (accounts, guests, name, menu links, quality and load limits, single sign-on, ...)
# is on the server's settings page: Settings → Server settings.

# your domain (Caddy gets the HTTPS certificate), or ":80" for plain HTTP on a LAN
TUBEHAUS_SITE=tube.example.com

# ---- only if you need them ----
# the host ports Caddy is published on: a port ("8080") or an address and port ("127.0.0.1:8080")
#   plain HTTP on a LAN:            TUBEHAUS_SITE=:80  TUBEHAUS_HTTP_BIND=8080  TUBEHAUS_URL=http://192.168.1.10:8080
#   behind your own nginx/Traefik:  TUBEHAUS_SITE=:80  TUBEHAUS_HTTP_BIND=127.0.0.1:8080  TUBEHAUS_HTTPS_BIND=127.0.0.1:8443
# TUBEHAUS_HTTP_BIND=80
# TUBEHAUS_HTTPS_BIND=443
# where browsers open TubeHaus, when it isn't https://<TUBEHAUS_SITE>
# TUBEHAUS_URL=
# deploy/docker-compose.public.yml only: key for the Anubis bot check (openssl rand -hex 32)
# ANUBIS_KEY=

# ---- fixing a setting here instead of on the settings page ----
# A value set here wins over the page's (the page shows it as fixed). Leave them out to use the page.
# TUBEHAUS_AUTH=accounts          # accounts / none / basic (basic: one shared password, with the two below)
# TUBEHAUS_USER=
# TUBEHAUS_PASSWORD_HASH=         # from: docker compose run --rm caddy caddy hash-password (write every $ as $$)
# TUBEHAUS_PUBLIC=1               # a public instance: read "Running a public instance" in the README first
# TUBEHAUS_MAX_ACCOUNTS=4
# TUBEHAUS_GUESTS=1
# TUBEHAUS_SAVED_MAX_GB=50
# TUBEHAUS_MAX_VIEWERS=0
# TUBEHAUS_MAX_HEIGHT=0
# TUBEHAUS_RATE_PER_MIN=
# TUBEHAUS_NAME=
# TUBEHAUS_LINKS=[{"name":"Home hub","url":"https://hub.example.com/"}]
# TUBEHAUS_SUB_LANG=en
# TUBEHAUS_CAPTION_LANG=auto
# TUBEHAUS_OIDC_ISSUER=https://auth.example.com/application/o/tubehaus/
# TUBEHAUS_OIDC_CLIENT_ID=
# TUBEHAUS_OIDC_CLIENT_SECRET=
# TUBEHAUS_OIDC_NAME=Authentik
# TUBEHAUS_OIDC_ONLY=0
# TUBEHAUS_PREFETCH=4             # videos looked up ahead so they start at once (0 = the least traffic)


# ============ running the server without docker (deploy/tubehaus.service) ============
# HT_BIND=127.0.0.1
# HT_PORT=3010
# HT_STATE=./state                          # library, settings (config.json) and subtitle cache
# HT_PUBLIC_URL=https://tube.example.com    # where browsers open TubeHaus
# HT_YT_PROXY=127.0.0.1:40000               # Cloudflare WARP in proxy mode ("" = direct)
# HT_WARP_ROTATE=1                          # reconnect WARP when YouTube blocks the address
# HT_REGION=US                              # the default region of searches and the trending page
# HT_HL=                                    # YouTube's language for its texts ("3 days ago"); empty = English
# HT_YTDLP=yt-dlp                           # + bgutil-ytdlp-pot-provider, for live streams
# HT_WHISPER_BIN=/opt/whisper/build/bin/whisper-cli
# HT_WHISPER_MODEL=/opt/whisper/models/ggml-base-q5_1.bin
# HT_LIBRETRANSLATE=                        # optional translation fallback
# HT_DOWNLOAD_DIR=/var/tmp/tubehaus-dl      # offline save (needs ffmpeg, ~10 GB free)
# HT_PUBLIC_PROXIES=0                       # proxies with public addresses in front of yours
# HT_MAX_BODY_MB=64                         # largest request body
# The settings on the settings page can be set here too (HT_ACCOUNTS=1, HT_GUESTS=1, HT_NAME=...): they win over the page.
