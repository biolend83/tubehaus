{
  "$schema": "https://flisk.sh/schema.service.json",
  "schemaVersion": 1,
  "appName": "companion",
  "appType": "bring-your-own",
  "stack": "tubehaus",
  "port": 8282,
  "image": "quay.io/invidious/invidious-companion:latest",
  "exposeViaProxy": false,
  "env": {
    "SERVER_SECRET_KEY": "${COMPANION_KEY}",
    "PROXY": "socks5://tubehaus:1080",
    "NETWORKING_FETCH_TIMEOUT_MS": "15000",
    "NETWORKING_FETCH_RETRY_ENABLED": "true",
    "NETWORKING_FETCH_RETRY_TIMES": "3",
    "NETWORKING_FETCH_RETRY_INITIAL_DEBOUNCE": "200",
    "NETWORKING_FETCH_RETRY_DEBOUNCE_MULTIPLIER": "2",
    "JOBS_YOUTUBE_SESSION_FREQUENCY": "0 * * * *"
  },
  "restart": "unless-stopped",
  "container": {
    "capDrop": [
      "ALL"
    ],
    "readOnly": true,
    "user": "10001:10001",
    "securityOpt": [
      "no-new-privileges:true"
    ],
    "shmSize": "256mb"
  },
  "volumes": [
    {
      "source": "companion-cache",
      "target": "/var/tmp/youtubei.js"
    }
  ]
}
